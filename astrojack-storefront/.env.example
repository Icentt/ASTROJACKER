PORT=4173
PUBLIC_URL=http://localhost:4173

# Admin account (generate the scrypt hash with: node server.mjs --hash-admin-password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# PayPal REST app credentials (sandbox for testing)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayMongo test secret key and the webhook signing secret
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
